{
  "appId": "io.github.issa13.itqan",
  "appName": "إتقان",
  "webDir": "www",
  "backgroundColor": "#f4efe1",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f4efe1"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#f4efe1",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT"
    }
  }
}
