# Copy this file to "keystore.properties" (same folder) and fill it in.
# keystore.properties and the .jks key are git-ignored: keep them OFF GitHub
# and keep a backup somewhere safe — if you lose the key you can never
# update the app on Google Play again.
storeFile=itqan-release.jks
storePassword=CHANGE_ME
keyAlias=itqan
keyPassword=CHANGE_ME
